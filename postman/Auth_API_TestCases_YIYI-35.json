{
  "info": {
    "_postman_id": "yiyi-auth-api-testsuite-yiyi35",
    "name": "Auth API Test Suite (YIYI-35)",
    "description": "Comprehensive Test Cases for YiYi Bookstore Authentication & Authorization API. Covers Register, Login, Token lifecycle, RBAC, Validation, Duplication, and Boundary cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Đăng ký (Register) - Positive & Welcome Gifts",
      "item": [
        {
          "name": "TC-AUTH-REG-001: Đăng ký khách hàng mới thành công (Đầy đủ thông tin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 1000000);",
                  "const ts = Date.now();",
                  "pm.environment.set(\"dynamicEmail\", \"test_reg_\" + ts + \"_\" + rand + \"@example.com\");",
                  "pm.environment.set(\"dynamicPhone\", \"09\" + Math.floor(10000000 + Math.random() * 90000000));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.test(\"Response contains valid JWT token and user info\", function () {",
                  "    pm.expect(data).to.have.property(\"token\");",
                  "    pm.expect(data.token).to.be.a(\"string\");",
                  "    pm.expect(data.token.split(\".\").length).to.equal(3);",
                  "    pm.expect(data).to.have.property(\"user\");",
                  "    pm.expect(data.user.email).to.equal(pm.environment.get(\"dynamicEmail\"));",
                  "    pm.expect(data.user.role).to.equal(\"USER\");",
                  "    pm.expect(data.user.provider).to.equal(\"LOCAL\");",
                  "});",
                  "",
                  "if (data.token) {",
                  "    pm.environment.set(\"authToken\", data.token);",
                  "    pm.environment.set(\"authUserId\", data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Văn Test\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"phone\": \"{{dynamicPhone}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "TC-AUTH-REG-002: Đăng ký thành công không cung cấp số điện thoại (Phone Optional)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set(\"dynamicEmailNoPhone\", \"nophone_\" + ts + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test(\"Token exists and user phone is null or empty\", function () {",
                  "    pm.expect(data.token).to.exist;",
                  "    pm.expect(data.user.email).to.equal(pm.environment.get(\"dynamicEmailNoPhone\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Trần Thị Không SĐT\",\n  \"email\": \"{{dynamicEmailNoPhone}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "TC-AUTH-REG-003: Đăng ký với tên tiếng Việt có dấu (Unicode UTF-8)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set(\"unicodeEmail\", \"unicode_\" + ts + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test(\"Full name Unicode UTF-8 preserved correctly\", function () {",
                  "    pm.expect(data.user.fullName).to.equal(\"Nguyễn Hoàng Đăng Khoa\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Hoàng Đăng Khoa\",\n  \"email\": \"{{unicodeEmail}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
