        {
          "name": "TC-AUTH-REG-006: Đăng ký thất bại khi body rỗng",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejected with error status (400/500)\", function () {",
                  "    pm.expect([400, 500]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Đăng ký (Register) - Duplicate & Conflict",
      "item": [
        {
          "name": "TC-AUTH-REG-007: Đăng ký thất bại khi trùng Email đã tồn tại",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejected with error status (400/409/500)\", function () {",
                  "    pm.expect([400, 409, 500]).to.include(pm.response.code);",
                  "});",
                  "const text = pm.response.text();",
                  "pm.test(\"Error message indicates email duplicate\", function () {",
                  "    pm.expect(text).to.match(/email/i);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Email User\",\n  \"email\": \"user@example.com\",\n  \"phone\": \"0987654321\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Đăng nhập (Login) - Positive (User & Admin)",
      "item": [
        {
          "name": "TC-AUTH-LOG-001: Đăng nhập USER thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.test(\"Response contains JWT token and user info with role USER\", function () {",
                  "    pm.expect(data.token).to.exist;",
                  "    pm.expect(data.user).to.exist;",
                  "    pm.expect(data.user.email).to.equal(\"user@example.com\");",
                  "    pm.expect(data.user.role).to.equal(\"USER\");",
                  "});",
                  "",
                  "if (data.token) {",
                  "    pm.environment.set(\"userToken\", data.token);",
                  "    pm.environment.set(\"token\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "TC-AUTH-LOG-002: Đăng nhập ADMIN thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.test(\"Response contains JWT token and user info with role ADMIN\", function () {",
                  "    pm.expect(data.token).to.exist;",
                  "    pm.expect(data.user).to.exist;",
                  "    pm.expect(data.user.email).to.equal(\"admin@example.com\");",
                  "    pm.expect(data.user.role).to.equal(\"ADMIN\");",
                  "});",
                  "",
                  "if (data.token) {",
                  "    pm.environment.set(\"adminToken\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Đăng nhập (Login) - Negative & Bad Credentials",
      "item": [
        {
          "name": "TC-AUTH-LOG-003: Đăng nhập thất bại khi sai Mật khẩu",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 400/401/403/500 on wrong password\", function () {",
                  "    pm.expect([400, 401, 403, 500]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"No token returned\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"eyJhbGci\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"WrongPassword_999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "TC-AUTH-LOG-004: Đăng nhập thất bại khi Email không tồn tại",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 400/401/403/404/500 for non-existent user\", function () {",
                  "    pm.expect([400, 401, 403, 404, 500]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nonexistent_user_9999@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Token Lifecycle & Security",
      "item": [
        {
          "name": "TC-AUTH-TOK-001: Truy cập endpoint bảo vệ với Bearer token hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "TC-AUTH-TOK-002: Chặn truy cập khi thiếu Authorization Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized or 403 Forbidden\", function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "TC-AUTH-TOK-003: Chặn truy cập với Token bị giả mạo chữ ký (Tampered Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized or 403 Forbidden\", function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}tamperedSignature"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Phân quyền truy cập (RBAC)",
      "item": [
        {
          "name": "TC-AUTH-RBAC-001: USER bị chặn 403 khi truy cập API của ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 403 Forbidden\", function () {",
                  "    pm.expect(pm.response.code).to.equal(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "TC-AUTH-RBAC-002: ADMIN truy cập thành công 200 OK API của ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test(\"Admin users list returned\", function () {",
                  "    pm.expect(Array.isArray(data) || Array.isArray(data.content)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "08 - Kháng Injection & An toàn dữ liệu",
      "item": [
        {
          "name": "TC-AUTH-SEC-001: Chặn SQL Injection trong Email đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 400/401/403/500 and not bypassed\", function () {",
                  "    pm.expect([400, 401, 403, 500]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"' OR '1'='1' --\",\n  \"password\": \"' OR '1'='1'\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    }
  ]
}
