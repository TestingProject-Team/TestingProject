<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/filter/3.0.0/findbugsfilter.xsd">

    <!-- Ignore Lombok generated classes/methods -->
    <Match>
        <Class name="~.*\$.*Builder"/>
    </Match>

    <!-- Ignore transient/entity specific fields in DTOs and Entities -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Ignore test classes for strict spotbugs checks -->
    <Match>
        <Class name="~.*Test"/>
    </Match>

    <!-- Ignore Spring ApplicationContextAware static setter pattern -->
    <Match>
        <Class name="com.bookstore.config.SpringContext"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- Ignore Constructor exception in FileController directory initialization -->
    <Match>
        <Class name="com.bookstore.controller.FileController"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Ignore broad exception catching in third-party payment callbacks -->
    <Match>
        <Class name="~com\.bookstore\.(controller|config)\..*(Payment|VNPay|ZaloPay|MoMo).*"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>
</FindBugsFilter>
