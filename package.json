{
  "name": "yiyi-bookstore-testing",
  "version": "1.0.0",
  "description": "End-to-end and integration testing suites for YiYi Bookstore (CodeceptJS)",
  "scripts": {
    "test:e2e": "codeceptjs run --steps",
    "test:e2e:headless": "cross-env HEADLESS=true codeceptjs run --steps",
    "test:e2e:ui": "codecept-ui --app",
    "test:e2e:verify": "powershell -ExecutionPolicy Bypass -File test-scripts/verify-codeceptjs-e2e.ps1"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^0.10.0",
    "@codeceptjs/helper": "^2.0.1",
    "@codeceptjs/ui": "^0.5.0",
    "codeceptjs": "^3.5.15",
    "playwright": "^1.40.0"
  }
}
